# ═══════════════════════════════════════════════
# ISSR Funding Intelligence Configuration
# ═══════════════════════════════════════════════

# ── Grants.gov API ──
GRANTS_GOV_BASE_URL=https://api.grants.gov/v1/api
GRANTS_GOV_SEARCH_ENDPOINT=search2
GRANTS_GOV_FETCH_ENDPOINT=fetchOpportunity
# No "agencies" key = all ~26 federal agencies, not just NSF. oppStatuses is
# pipe-delimited; "forecasted|posted" pulls open + upcoming and excludes
# closed/archived. Page size/max pages give ~3,000-record capacity -- checked
# live against the API's own hitCount (1,665 open+forecasted government-wide
# at the time this was set) for headroom as that count grows.
GRANTS_GOV_PAGE_SIZE=100
GRANTS_GOV_MAX_PAGES=30
GRANTS_GOV_QUERY={"oppStatuses": "forecasted|posted"}
# Delay between fetchOpportunity calls -- all-agency polling means ~1,500+
# sequential detail requests per run against a public, unauthenticated API.
GRANTS_GOV_REQUEST_DELAY_SECONDS=0.15

# ── NSF Scraping ──
NSF_RSS_URL=https://www.nsf.gov/funding/opportunities/rss.xml
NSF_SCRAPER_RATE_LIMIT=1.0
NSF_SCRAPER_MAX_CONCURRENT=3

# ── Paths ──
SQLITE_DB_PATH=data/queues/nsf_queue.db
APP_DB_PATH=data/db/funding_intelligence.db
RAW_OUTPUT_DIR=data/raw
NORMALISED_OUTPUT_DIR=data/normalised
EMBEDDINGS_CACHE_DIR=data/embeddings
ONTOLOGY_DIR=data/ontology
EVALUATION_DIR=data/evaluation

# ── Tagging ──
SPACY_MODEL=en_core_web_lg
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# Per-category Layer 2 cosine thresholds, as JSON. A concept_id key (e.g.
# "method_25") overrides its category, for concepts that are persistently
# over-triggered by boilerplate. Note this is COSINE_THRESHOLDS (plural) — an
# earlier COSINE_THRESHOLD singular was never read by the application.
COSINE_THRESHOLDS={"method": 0.40, "population": 0.35, "research_domain": 0.35, "research_discipline": 0.35, "sponsor_theme": 0.30, "default": 0.35, "method_25": 0.65}
# Layer 3 requires a local Ollama server; the pipeline degrades to Layer 2
# scores if it is unreachable.
ENABLE_LAYER3_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
# How much Layer 2 scores the title as its own signal vs. blending it into the
# body text before chunking. 0.0 (default) leaves body-only scoring unchanged.
TITLE_WEIGHT=0.0
# "blend" averages the title into the body embedding; "max" scores them
# separately and keeps the higher of the two. Only matters if TITLE_WEIGHT > 0.
TITLE_COMBINE=blend
# Comma-separated ontology categories where an L1 hit is suppressed unless L2
# independently agrees (see Documentation/EVALUATION.md 4j). Empty by default:
# measured net-negative in aggregate, kept disabled.
L1_CORROBORATION_CATEGORIES=

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
# Comma-separated origins. The Next.js frontend (web/) runs as its own server
# on :3000, a different origin from this API's :8000, so it needs an entry
# here even in local dev. "*" is accepted but disables credentialed requests.
API_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
# Per-IP requests per minute; /api/health is exempt. Set to 0 to disable.
API_RATE_LIMIT_PER_MINUTE=120
# Upper bound on rows returned by a single export request.
API_EXPORT_MAX_ROWS=10000
# How many of the top AI Match results get an LLM-generated explanation
# (each one is a separate ~20s-timeout call, so this caps request latency).
MATCH_EXPLAIN_TOP_K=5

# ── General ──
LOG_LEVEL=INFO
USER_AGENT=foa-pipeline/1.0
SCHEMA_VERSION=1.0
