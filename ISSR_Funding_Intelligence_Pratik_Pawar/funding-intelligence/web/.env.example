# Server-only: used by Server Component fetches (never reaches the browser).
# In Docker, point this at the api service name; locally, at localhost:8000.
API_BASE_URL=http://localhost:8000

# Public: inlined into the client bundle at build time. Used by genuinely
# client-side calls (the AI Match view). Must be reachable from the browser,
# and must be listed in the API's API_CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
